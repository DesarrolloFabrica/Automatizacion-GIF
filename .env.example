# OpenAI / Gemini API Configuration
# By default, uses Google AI Studio (Gemini) OpenAI-compatible endpoint.
# To use official OpenAI instead, set OPENAI_BASE_URL to https://api.openai.com/v1
OPENAI_API_KEY=

# Optional: custom OpenAI-compatible endpoint
# Default: https://generativelanguage.googleapis.com/v1beta/openai/
OPENAI_BASE_URL=

# Optional: global model override (all tasks)
OPENAI_MODEL=

# Per-task model overrides (fallback to OPENAI_MODEL, then Gemini defaults)
OPENAI_MODEL_GRANULES=
OPENAI_MODEL_TXT=
OPENAI_MODEL_DOCX=
OPENAI_MODEL_MATERIALS=
OPENAI_MODEL_REPAIR=

# Parallel execution settings
GRANULES_PARALLEL=1
GRANULES_MAX_WORKERS=3
GCS_BUCKET=automatizacion-gif-jobs-dev
PIPELINE_LOCAL_PARALLEL=1
PIPELINE_LOCAL_MAX_WORKERS=4
MATERIALS_PARALLEL=1
MATERIALS_MAX_WORKERS=4
MATERIALS_API_RETRIES=2
MATERIALS_REPAIR_ATTEMPTS=1
