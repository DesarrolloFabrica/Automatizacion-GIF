# OpenAI-compatible LLM configuration
# Providers:
# - Gemini default: leave LLM_PROVIDER empty and set OPENAI_API_KEY
# - OpenAI official: set OPENAI_BASE_URL=https://api.openai.com/v1 and OPENAI_API_KEY
# - Ollama local/tunnel: set LLM_PROVIDER=ollama, OLLAMA_BASE_URL and OLLAMA_MODEL
LLM_PROVIDER=
OPENAI_API_KEY=

# Optional: custom OpenAI-compatible endpoint
# Gemini default: https://generativelanguage.googleapis.com/v1beta/openai/
# Ollama default when LLM_PROVIDER=ollama: http://localhost:11434/v1
OPENAI_BASE_URL=

# Ollama settings
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:3b

# Optional: global model override (all tasks)
OPENAI_MODEL=

# Per-task model overrides (fallback to OPENAI_MODEL, then Ollama/Gemini defaults)
OPENAI_MODEL_GRANULES=
OPENAI_MODEL_TXT=
OPENAI_MODEL_DOCX=
OPENAI_MODEL_MATERIALS=
OPENAI_MODEL_REPAIR=

# Parallel execution settings
GRANULES_PARALLEL=1
GRANULES_MAX_WORKERS=3
GCS_BUCKET=automatizacion-gif-jobs-dev
PIPELINE_LOCAL_PARALLEL=1
PIPELINE_LOCAL_MAX_WORKERS=4
MATERIALS_PARALLEL=1
MATERIALS_MAX_WORKERS=4
MATERIALS_API_RETRIES=2
MATERIALS_REPAIR_ATTEMPTS=1
